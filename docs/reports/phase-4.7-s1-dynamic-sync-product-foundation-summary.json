  "scope": {
    "product_feature_stage": true,
    "runner_only": false,
    "plan_only": false,
    "short_term_route": [
      "Phase 4.7-S1: Dynamic Sync Foundation + Product UI + AI/Localization Readiness",
      "Phase 4.7-S2: Baseline Full Import + Classification + AI Tagging + Tag Localization",
      "Phase 4.7-S3: Incremental Sync Automation + Hardening"
    ]
  },
  "dynamic_sync": {
    "schema": {
      "tables": [
        "blombooru_dynamic_source_roots",
        "blombooru_dynamic_source_items",
        "blombooru_dynamic_sync_runs",
        "blombooru_dynamic_sync_run_items"
      ],
      "idempotent_migration": true,
      "indexed_for_scale": true
    },
    "identity": {
      "source_item_identity": "source_root_id + relative_path_hash; media_id is only a post-import link",
      "media_id_only_identity": false,
      "content_hash_supported_when_computed": true
    },
    "default_off_policy": {
      "manual_check_available": true,
      "pending_count_visible": true,
      "threshold_visible": true,
      "auto_sync_enabled": false,
      "manual_sync_enabled": false,
      "threshold_triggered_writes_enabled": false
    },
    "threshold": {
      "default": 100,
      "config_key": "DYNAMIC_LIBRARY_SYNC_THRESHOLD",
      "threshold_reached_is_warning_only": true
    },
    "pending_counts": {
      "visible": true,
      "fields": [
        "pending_new",
        "pending_changed",
        "pending_deferred",
        "pending_import",
        "total_pending",
        "threshold",
        "threshold_reached"
      ]
    },
    "dry_run_no_import": true,
    "source_root_safety": {
      "passed": true,
      "absolute_paths_required": true,
      "filesystem_root_blocked": true,
      "project_root_overlap_blocked": true,
      "app_storage_overlap_blocked": true,
      "icloud_or_source_mutation": false
    },
    "manual_update_flow": {
      "source_roots_list_register": true,
      "check_for_updates": true,
      "run_dry_run": true,
      "sync_pending_prepared": true,
      "sync_pending_executes_import": false
    }
  },
  "ai_localization": {
    "chain_verified": true,
    "ai_tagging_auto_localization_default_enabled": true,
    "baseline_to_localization_chain": [
      "baseline import",
      "AI tagging job",
      "new tags collected",
      "_schedule_localization",
      "background worker / auto translate",
      "blombooru_tag_translations",
      "frontend Chinese display and trusted search aliases"
