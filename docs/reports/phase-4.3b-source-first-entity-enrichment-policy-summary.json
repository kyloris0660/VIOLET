  "provider_evaluation": {
    "danbooru_style_exact_post_lookup": {
      "suitability": "best_first_category_when_exact_source_or_post_id_exists",
      "provides": ["post_id", "source", "rating", "file_metadata", "categorized_tags_when_available"],
      "identity_use": "strong_for_exact_post_lookup",
      "first_pilot_candidate": true,
      "image_upload_required": false
    },
    "gelbooru_booru_style_dapi": {
      "suitability": "good_second_exact_source_category",
      "provides": ["post_id", "source", "rating", "tags", "dimensions", "file_url"],
      "identity_use": "moderate_to_strong_for_exact_post_lookup",
      "first_pilot_candidate": false,
      "image_upload_required": false
    },
    "saucenao_reverse_search": {
      "suitability": "defer_until_explicit_image_or_thumbnail_policy",
      "provides": ["source_candidates", "similarity_scores", "indexed_metadata"],
