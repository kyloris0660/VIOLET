      "suitability": "supplementary_local_recall_after_source_first_pilot",
      "provides": ["near_duplicates", "visual_neighbors"],
      "identity_use": "not_identity_truth",
      "first_pilot_candidate": false,
      "image_upload_required": false
    }
  },
  "privacy_eligibility_policy": {
    "anime": {
      "default": "eligible_only_under_explicit_provider_policy_and_run_approval",
      "preferred_query": "source_url_or_post_id_first",
      "image_upload": "requires_explicit_provider_policy"
    },
    "unknown": {
      "default": "blocked",
      "override": "manual_classification_or_explicit_approval_only",
      "rationale": "may_include_private_screenshots_or_personal_content"
    },
    "non_anime": {
      "default": "blocked"
    },
    "illustration": {
      "default": "blocked_until_project_defines_safe_anime_illustration_policy"
    },
    "local_paths_filenames_source_labels": "never_send_to_provider_or_public_report",
    "original_image_bytes": "blocked_by_default",
    "derived_thumbnail_hash_embedding": "explicit_provider_policy_only"
  },
  "external_call_reliability_policy": {
    "provider_enablement": "opt_in_only_external_source_enabled_false_by_default",
    "per_run_budget_fields": [
      "max_items",
      "max_requests",
      "max_failures",
      "max_consecutive_failures",
      "max_same_reason_failures",
      "max_runtime"
    ],
    "rate_limit_controls": [
      "requests_per_minute",
      "burst_control",
      "respect_retry_after",
      "provider_specific_backoff",
      "no_parallelism_unless_policy_allows"
    ],
    "error_classes": [
      "rate_limited",
      "auth_failed",
      "forbidden",
      "timeout",
      "network_error",
      "provider_5xx",
      "schema_changed",
      "no_match",
      "low_confidence",
      "conflict",
      "privacy_blocked"
    ],
    "cache_first": true,
    "negative_cache": true,
    "public_report": "aggregate_redacted_only"
  },
  "cache_and_provenance_design": {
    "tables": [
      "ExternalSource",
      "ProviderCache",
      "NegativeLookupCache",
      "EntityEvidence",
      "EntityExternalIdentity",
      "MediaEntityCandidate"
    ],
    "query_hash": "stable_hash_of_redacted_request_shape",
    "query_types": [
      "exact_post_id",
      "source_url_lookup",
      "reverse_search_thumbnail",
      "work_metadata_lookup",
      "local_phash_cluster"
    ],
    "required_cache_fields": [
      "provider",
      "query_hash",
      "query_type",
      "request_shape_redacted",
      "response_status",
      "response_json_redacted",
      "error_class",
      "fetched_at",
      "expires_at"
    ],
    "evidence_privacy_redacted_required": true
  },
  "match_confidence_policy": {
    "automatic_confirmed_assignments_in_first_pilot": false,
    "tiers": {
      "exact_source_url_match": {
        "candidate_allowed": true,
        "assignment_allowed": false,
        "manual_review_required": true,
        "confidence_range": [0.9, 1.0]
      },
      "exact_post_id_match": {
        "candidate_allowed": true,
        "assignment_allowed": false,
        "manual_review_required": true,
        "confidence_range": [0.9, 1.0]
      },
      "source_metadata_character_match": {
        "candidate_allowed": true,
        "assignment_allowed": false,
        "manual_review_required": true,
        "confidence_range": [0.8, 0.95]
      },
      "multi_provider_agreement": {
        "candidate_allowed": true,
        "assignment_allowed": false,
        "manual_review_required": true,
        "confidence_range": [0.85, 0.98]
      },
      "high_score_reverse_search": {
        "candidate_allowed": true,
        "assignment_allowed": false,
        "manual_review_required": true,
        "confidence_range": [0.75, 0.95]
      },
      "low_score_reverse_search": {
        "candidate_allowed": false,
        "evidence_only": true,
        "assignment_allowed": false,
        "confidence_range": [0.3, 0.74]
      },
      "conflicting_metadata": {
        "candidate_allowed": false,
        "evidence_only": true,
        "assignment_allowed": false
      },
      "no_match": {
        "candidate_allowed": false,
        "negative_cache": true
      },
      "privacy_blocked": {
        "candidate_allowed": false,
        "negative_cache_or_audit": true
      }
    }
  },
