    "trace_moe": {
      "suitability": "supplementary_for_anime_screenshots_not_primary_illustration_identity",
      "provides": ["anime_scene_lookup", "timestamp", "work_reference"],
      "identity_use": "weak_for_illustration_or_post_identity",
      "first_pilot_candidate": false,
      "image_upload_required": true
    },
    "anilist": {
      "suitability": "work_metadata_supplement_after_source_evidence",
      "provides": ["work_ids", "titles", "relations", "metadata"],
      "identity_use": "work_normalization_not_media_post_identity",
      "first_pilot_candidate": false,
      "image_upload_required": false
    },
    "pixiv_source_url": {
      "suitability": "exact_url_parsing_possible_future_local_parser_network_calls_blocked_until_policy_review",
