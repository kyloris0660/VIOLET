# ============================================================
# V.I.O.L.E.T. — Worktree Test Configuration
# Use when running tests from a git worktree.
#
# Combines worktree storage isolation with test DB safety.
# ============================================================

VIOLET_ENV=test

# --- Test Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blombooru_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Storage: MUST NOT point to main repo ---
VIOLET_STORAGE_ROOT=C:\Users\kyloris\VioletStorage\test

# --- Destructive E2E (only when intentional) ---
# VIOLET_ALLOW_DESTRUCTIVE_E2E=1

# --- App ---
APP_PORT=8001
BLOMBOORU_LANGUAGE=zh-cn

# --- Disable heavy features ---
AI_TAGGING_ENABLED=false
TAG_TRANSLATION_LLM_ENABLED=false
CONTENT_CLASSIFICATION_ENABLED=false
