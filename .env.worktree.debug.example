# ============================================================
# V.I.O.L.E.T. — Worktree Debug Configuration
# Use when running a dev server from a git worktree.
#
# The worktree's CODE_ROOT differs from the main repo, so
# VIOLET_STORAGE_ROOT MUST be set to avoid writing into
# the worktree directory tree.
# ============================================================

VIOLET_ENV=development

# REQUIRED in worktrees: keep storage in a stable, shared location
VIOLET_STORAGE_ROOT=C:\Users\kyloris\VioletStorage\dev

# --- Destructive E2E: explicitly disabled for debug worktrees ---
VIOLET_ALLOW_DESTRUCTIVE_E2E=0

# --- Database (uses same dev DB as main repo) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blombooru
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- App ---
APP_PORT=8000
BLOMBOORU_LANGUAGE=zh-cn
DEBUG=true
