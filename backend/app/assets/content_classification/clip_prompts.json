      "prompts": [
        "real photograph",
        "camera photo of a real scene",
        "real world photo",
        "landscape photograph",
        "product photograph"
      ],
      "maps_to": "non_anime"
    },
    "screenshot": {
      "prompts": [
        "computer screenshot",
        "user interface screenshot",
        "mobile app screenshot"
      ],
      "maps_to": "non_anime"
    },
    "document": {
      "prompts": [
        "scanned document",
        "text document page"
      ],
      "maps_to": "non_anime"
    }
  }
