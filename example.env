# V.I.O.L.E.T. Configuration
BLOMBOORU_TAG=latest # set to `pre` for the latest pre-release, `latest` for the latest stable release, or a version tag (e.g. `1.2.3`)

# Application Settings
APP_NAME=V.I.O.L.E.T.
APP_PORT=8000

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=blombooru
POSTGRES_HOST=db
POSTGRES_PORT=5432 # used for the Host port mapping in Docker, does not affect the internal application port.

# Redis Settings
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379 # used for the Host port mapping in Docker, does not affect the internal application port.
REDIS_DB=0
REDIS_PASSWORD=supersecretpasswordbutredis

# Local Library Scan
# Paths to scan for images. Use | to separate multiple paths.
# Spaces in paths are supported, no quoting needed.
# LOCAL_LIBRARY_PATHS=C:\Users\username\Pictures\My Photos|D:\Art\Collection

# AI Auto Tagging (Phase 2.1)
# Set to true to enable AI tagging features in the Admin UI
# AI_TAGGING_ENABLED=false
# Confidence thresholds: tags above confirm threshold are confirmed,
# between suggestion and confirm are suggestions, below suggestion are ignored.
# AI_GENERAL_THRESHOLD=0.35
# AI_CHARACTER_THRESHOLD=0.65
# AI_RATING_THRESHOLD=0.50
# AI_SUGGESTION_THRESHOLD=0.20
# Maximum items per batch AI tagging request
# AI_TAGGING_BATCH_MAX_ITEMS=10
# ONNX model to use (default: wd-swinv2-tagger-v3, a good balance of speed/quality)
# Available: wd-vit-tagger-v3, wd-convnext-tagger-v3, wd-swinv2-tagger-v3,
#            wd-eva02-large-tagger-v3, wd-vit-large-tagger-v3
# AI_MODEL_NAME=wd-swinv2-tagger-v3

# 注意：AI_TAGGING_BATCH_MAX_ITEMS 是所有 AI 打标任务的硬上限。
# AI_AUTO_TAG_AFTER_IMPORT_MAX_ITEMS 会被此值截断。
# 同时修改两个值以避免混淆（如都设为 200）。
# 修改 .env 后必须重启服务。可通过 Admin → System → 开发者工具 验证配置。

# Shared Tag Database Settings
SHARED_TAGS_ENABLED=false
SHARED_TAG_DB_USER=postgres
SHARED_TAG_DB_PASSWORD=supersecretsharedtagdbpassword
SHARED_TAG_DB=shared_tags
SHARED_TAG_DB_HOST=shared-tag-db
SHARED_TAG_DB_PORT=5431 # used for the Host port mapping in Docker, does not affect the internal application port.

# Tag Translation / Localization (Phase 2.2.2)
# Enable LLM-based tag translation (default: disabled)
# TAG_TRANSLATION_LLM_ENABLED=false
# LLM provider type (currently only openai_compatible supported)
# TAG_TRANSLATION_LLM_PROVIDER=openai_compatible
# API key for the LLM provider (read from env, never commit)
# TAG_TRANSLATION_LLM_API_KEY=
# Model name for the LLM provider
# TAG_TRANSLATION_LLM_MODEL=
# Base URL for OpenAI-compatible API
# TAG_TRANSLATION_LLM_BASE_URL=
# Maximum tags per batch translation request
# TAG_TRANSLATION_BATCH_MAX_ITEMS=50
#
# Auto-translate new tags when they are created (requires LLM enabled above)
# TAG_TRANSLATION_AUTO_ENABLED=false
# Maximum tags to auto-translate per trigger (throttle)
# TAG_TRANSLATION_AUTO_MAX_ITEMS=20

# Background Continuous Tag Translation (Phase 2.3d)
# Automatically translates all missing tags in the background.
# When enabled, a worker runs periodically and processes untranslated tags via LLM.
# This replaces the need to manually trigger batch translations.
# NOTE: Requires TAG_TRANSLATION_LLM_ENABLED=true and a configured LLM API key.
# WARNING: Real LLM translation incurs API costs. Use daily_limit to control spending.
# Changes require server restart.
# TAG_TRANSLATION_BACKGROUND_ENABLED=false
# How often to check for missing tags (seconds)
# TAG_TRANSLATION_BACKGROUND_INTERVAL_SECONDS=300
# Tags per LLM API call (batch size)
# TAG_TRANSLATION_BACKGROUND_BATCH_SIZE=100
# Max tags per worker run (cycle cap)
# TAG_TRANSLATION_BACKGROUND_MAX_PER_RUN=500
# Max tags per day (cost protection, resets at midnight)
# TAG_TRANSLATION_BACKGROUND_DAILY_LIMIT=5000
# Consecutive errors before auto-pause
# TAG_TRANSLATION_BACKGROUND_ERROR_LIMIT=5
# Priority: post_count (high-usage tags first)
# TAG_TRANSLATION_BACKGROUND_PRIORITY=post_count
# Which tag categories to translate (comma-separated). Default: general,meta
# Proper-noun categories (character, copyright, artist) need entity alias resolution, not translation.
# TAG_TRANSLATION_BACKGROUND_CATEGORIES=general,meta

# Entity Alias Resolver (Phase 2.3e)
# Resolves proper-noun tags (character, copyright, artist) to known Chinese aliases.
# Uses a fundamentally different LLM prompt than visual tag translation.
# NOTE: Requires TAG_TRANSLATION_LLM_ENABLED=true and a configured LLM API key.
# ENTITY_ALIAS_RESOLVER_ENABLED=false
# Tags per LLM API call for entity resolution
# ENTITY_ALIAS_BATCH_SIZE=20
# Max tags per resolver run
# ENTITY_ALIAS_MAX_PER_RUN=100

# Auto AI Tagging After Import (Phase 2.3)
# When enabled, a background AI tagging job is automatically created after
# each Local Library Scan completes. Default: disabled for safety.
# AI_AUTO_TAG_AFTER_IMPORT=false
# Maximum images to auto-tag per scan (prevents runaway tagging)
# AI_AUTO_TAG_AFTER_IMPORT_MAX_ITEMS=20
# Only tag images newly imported in this scan (true) or any un-tagged images (false)
# AI_AUTO_TAG_AFTER_IMPORT_ONLY_NEW=true
# Run auto-tag in dry-run mode (no DB writes, useful for testing)
# AI_AUTO_TAG_AFTER_IMPORT_DRY_RUN=false
# Force all AI tags as suggestions (requires review before searchable)
# AI_AUTO_TAG_AFTER_IMPORT_FORCE_SUGGESTIONS=false

# ──────────────────────────────────────────────
# Recommended E2E Test Configuration
# ──────────────────────────────────────────────
# To test the full pipeline (scan → AI tag → localization → review → search),
# copy the block below into your .env and set your LLM API key / model.
# Use a small test directory (~100 images), NOT your full iCloud Photos.
#
# IMPORTANT: After changing .env, you MUST restart the server.
# Verify with: Admin → System → Developer Tools → Config Diagnostics
# Or call: GET /api/admin/dev/config-diagnostics
#
# Note: AI_TAGGING_BATCH_MAX_ITEMS is the hard cap for ALL AI tagging jobs.
#       AI_AUTO_TAG_AFTER_IMPORT_MAX_ITEMS is capped by AI_TAGGING_BATCH_MAX_ITEMS.
#       Set both to the same value to avoid confusion.
#
# LOCAL_LIBRARY_PATHS=C:\Users\kyloris\Pictures\VioletTest100
# AI_TAGGING_ENABLED=true
# AI_TAGGING_BATCH_MAX_ITEMS=200
# AI_AUTO_TAG_AFTER_IMPORT=true
# AI_AUTO_TAG_AFTER_IMPORT_MAX_ITEMS=200
# AI_AUTO_TAG_AFTER_IMPORT_ONLY_NEW=true
# AI_AUTO_TAG_AFTER_IMPORT_DRY_RUN=false
# AI_AUTO_TAG_AFTER_IMPORT_FORCE_SUGGESTIONS=false
# TAG_TRANSLATION_LLM_ENABLED=true
# TAG_TRANSLATION_AUTO_ENABLED=true
# TAG_TRANSLATION_AUTO_MAX_ITEMS=200
# TAG_TRANSLATION_BATCH_MAX_ITEMS=200
# TAG_TRANSLATION_LLM_API_KEY=<your-api-key>
# TAG_TRANSLATION_LLM_MODEL=<your-model>
# TAG_TRANSLATION_LLM_BASE_URL=<your-api-base-url>
# TAG_TRANSLATION_LLM_PROVIDER=openai_compatible
