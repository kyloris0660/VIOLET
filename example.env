# V.I.O.L.E.T. Configuration
BLOMBOORU_TAG=latest # set to `pre` for the latest pre-release, `latest` for the latest stable release, or a version tag (e.g. `1.2.3`)

# Application Settings
APP_NAME=V.I.O.L.E.T.
APP_PORT=8000

# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=blombooru
POSTGRES_HOST=db
POSTGRES_PORT=5432 # used for the Host port mapping in Docker, does not affect the internal application port.

# Redis Settings
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379 # used for the Host port mapping in Docker, does not affect the internal application port.
REDIS_DB=0
REDIS_PASSWORD=supersecretpasswordbutredis

# Local Library Scan
# Paths to scan for images. Use | to separate multiple paths.
# Spaces in paths are supported, no quoting needed.
# LOCAL_LIBRARY_PATHS=C:\Users\username\Pictures\My Photos|D:\Art\Collection

# AI Auto Tagging (Phase 2.1)
# Set to true to enable AI tagging features in the Admin UI
# AI_TAGGING_ENABLED=false
# Confidence thresholds: tags above confirm threshold are confirmed,
# between suggestion and confirm are suggestions, below suggestion are ignored.
# AI_GENERAL_THRESHOLD=0.35
# AI_CHARACTER_THRESHOLD=0.65
# AI_RATING_THRESHOLD=0.50
# AI_SUGGESTION_THRESHOLD=0.20
# Maximum items per batch AI tagging request
# AI_TAGGING_BATCH_MAX_ITEMS=10
# ONNX model to use (default: wd-swinv2-tagger-v3, a good balance of speed/quality)
# Available: wd-vit-tagger-v3, wd-convnext-tagger-v3, wd-swinv2-tagger-v3,
#            wd-eva02-large-tagger-v3, wd-vit-large-tagger-v3
# AI_MODEL_NAME=wd-swinv2-tagger-v3

# 注意：AI_TAGGING_BATCH_MAX_ITEMS 限制每次批量 AI 打标的最大数量。
# 此限制防止误操作导致全库 AI 打标。不建议完全移除上限。
# 可调整为更大值（如 50），但请配合 dry-run 使用。

# Shared Tag Database Settings
SHARED_TAGS_ENABLED=false
SHARED_TAG_DB_USER=postgres
SHARED_TAG_DB_PASSWORD=supersecretsharedtagdbpassword
SHARED_TAG_DB=shared_tags
SHARED_TAG_DB_HOST=shared-tag-db
SHARED_TAG_DB_PORT=5431 # used for the Host port mapping in Docker, does not affect the internal application port.
