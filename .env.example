# ============================================================
# V.I.O.L.E.T. — Development Configuration (default)
# Copy to .env and adjust as needed.
# ============================================================

VIOLET_ENV=development

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blombooru
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- App ---
APP_PORT=8000
BLOMBOORU_LANGUAGE=zh-cn
BLOMBOORU_DEBUG=true

# --- AI Tagging ---
# AI_TAGGING_ENABLED=true
# AI_MODEL_NAME=wd-swinv2-tagger-v3
# AI_GENERAL_THRESHOLD=0.35
# AI_CHARACTER_THRESHOLD=0.65
# AI_RATING_THRESHOLD=0.50
# AI_SUGGESTION_THRESHOLD=0.20
# AI_TAGGING_BATCH_MAX_ITEMS=10
# AI_AUTO_TAG_AFTER_IMPORT=false
# AI_AUTO_TAG_AFTER_IMPORT_MAX_ITEMS=20

# --- LLM Tag Translation ---
# TAG_TRANSLATION_LLM_ENABLED=true
# TAG_TRANSLATION_LLM_PROVIDER=openai_compatible
# TAG_TRANSLATION_LLM_BASE_URL=https://your-api-url
# TAG_TRANSLATION_LLM_API_KEY=your-api-key
# TAG_TRANSLATION_LLM_MODEL=your-model-name
# TAG_TRANSLATION_BATCH_MAX_ITEMS=50
# TAG_TRANSLATION_AUTO_ENABLED=false
# TAG_TRANSLATION_AUTO_MAX_ITEMS=20

# --- LLM Fallback Provider (optional second LLM for resilience) ---
# TAG_TRANSLATION_LLM_FALLBACK_BASE_URL=
# TAG_TRANSLATION_LLM_FALLBACK_API_KEY=
# TAG_TRANSLATION_LLM_FALLBACK_MODEL=

# --- Entity Alias Resolver ---
# ENTITY_ALIAS_RESOLVER_ENABLED=false
# ENTITY_ALIAS_BATCH_SIZE=20
# ENTITY_ALIAS_MAX_PER_RUN=100

# --- Content Classification ---
# CONTENT_CLASSIFICATION_ENABLED=true
# CONTENT_CLASSIFICATION_METHOD=clip
# CONTENT_CLASSIFICATION_BATCH_MAX_ITEMS=100
# CONTENT_CLASSIFICATION_AUTO_AFTER_IMPORT=false
# CONTENT_CLASSIFICATION_AUTO_MAX_ITEMS=50
# CONTENT_CLASSIFICATION_CLIP_UNKNOWN_MARGIN=0.005
