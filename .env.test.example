# ============================================================
# V.I.O.L.E.T. — Test Configuration
# For running tests against a dedicated test database.
#
# CRITICAL: POSTGRES_DB must NOT be 'blombooru' (the prod default).
# The fail-closed logic will refuse to start if it detects the
# production DB name when VIOLET_ENV=test.
# ============================================================

VIOLET_ENV=test

# --- Test Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=blombooru_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Storage: should NOT overlap with dev/production storage ---
VIOLET_STORAGE_ROOT=C:\Users\kyloris\VioletStorage\test
VIOLET_TEST_STORAGE_ROOT=C:\Users\kyloris\VioletStorage\test

# --- Test fixture path (for E2E tests with real images) ---
VIOLET_TEST_FIXTURE_PATH=C:\Users\kyloris\Pictures\VioletTestFixture

# --- Destructive E2E (only when intentional) ---
VIOLET_ALLOW_DESTRUCTIVE_E2E=1

# --- App ---
APP_PORT=8001
BLOMBOORU_LANGUAGE=zh-cn

# --- Disable heavy features for fast tests ---
AI_TAGGING_ENABLED=false
TAG_TRANSLATION_LLM_ENABLED=false
CONTENT_CLASSIFICATION_ENABLED=false

# --- TEST_DATABASE_URL (advanced, optional) ---
# When VIOLET_ENV=test: if set, overrides both POSTGRES_DB and DATABASE_URL.
# Safety: config.py validates against forbidden DB names (blombooru, production,
# main, postgres). Use this when the test DB is on a different host/port.
# Format: postgresql://user:pass@host:port/dbname
# TEST_DATABASE_URL=

# --- E2E gating ---
# VIOLET_RUN_REAL_E2E=1
# VIOLET_RUN_REAL_LLM_E2E=1
